<section class="rv-scope rv-section" style="--rv-pad-top: {{ section.settings.padding_top }}px; --rv-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="rv-container">
    <div class="rv-press" style="--rv-logo-h: {{ section.settings.logo_height }}px;">
      {%- render 'rv-pill', text: section.settings.heading, style: 'white' -%}
      <div class="rv-press__logos">
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_style = ''
            if block.settings.height > 0
              assign block_style = 'height: ' | append: block.settings.height | append: 'px;'
            endif
          -%}
          {%- capture logo -%}
            {%- if block.settings.logo != blank -%}
              {{ block.settings.logo | image_url: height: 160 | image_tag: loading: 'lazy', alt: block.settings.name | default: block.settings.logo.alt, style: block_style }}
            {%- else -%}
              <span class="rv-press__text">{{ block.settings.name }}</span>
            {%- endif -%}
          {%- endcapture -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>{{ logo }}</a>
          {%- else -%}
            <span {{ block.shopify_attributes }}>{{ logo }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviv press logos",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where we have been covered" },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 16, "max": 60, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [{
    "type": "logo", "name": "Logo",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo image" },
      { "type": "text", "id": "name", "label": "Publication name", "info": "Used as alt text, or shown when no image is set" },
      { "type": "range", "id": "height", "label": "Logo height override", "info": "0 uses the section's logo height. Raise this for logos that look small next to the others.", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 0 },
      { "type": "url", "id": "link", "label": "Article link" }
    ]
  }],
  "presets": [{
    "name": "Reviv press logos",
    "blocks": [
      { "type": "logo", "settings": { "name": "Apple News" } },
      { "type": "logo", "settings": { "name": "Business Insider" } },
      { "type": "logo", "settings": { "name": "Yahoo Finance" } },
      { "type": "logo", "settings": { "name": "Associated Press" } },
      { "type": "logo", "settings": { "name": "MarketWatch" } }
    ]
  }]
}
{% endschema %}
