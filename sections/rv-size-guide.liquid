{%- liquid
  assign s = section.settings
  assign cards = section.blocks | where: 'type', 'size'
  assign rows = section.blocks | where: 'type', 'row'
  assign video_src = ''
  if s.video != blank
    if s.video.type == 'youtube'
      assign video_src = 'https://www.youtube.com/watch?v=' | append: s.video.id
    elsif s.video.type == 'vimeo'
      assign video_src = 'https://vimeo.com/' | append: s.video.id
    endif
  endif
-%}
<section class="rv-scope rv-section" id="{{ s.anchor | default: 'size-guide' }}" style="--rv-pad-top: {{ s.padding_top }}px; --rv-pad-bottom: {{ s.padding_bottom }}px; scroll-margin-top: 20px;" aria-labelledby="rv-sg-{{ section.id }}">
  <div class="rv-container">
    <div class="rv-head">
      <div>
        {%- render 'rv-pill', text: s.eyebrow -%}
        <h2 class="rv-head__title" id="rv-sg-{{ section.id }}">{{ s.heading }}</h2>
        {%- if s.subheading != blank -%}<p class="rv-head__sub rv-sg__sub">{{ s.subheading }}</p>{%- endif -%}
      </div>
    </div>

    {%- if cards.size > 0 -%}
      <div class="rv-sg__cards">
        {%- for block in cards -%}
          {%- assign b = block.settings -%}
          <div class="rv-sg__card{% if b.highlight %} is-highlight{% endif %}" {{ block.shopify_attributes }}>
            {%- if b.badge != blank -%}<span class="rv-badge rv-badge--gold">{{ b.badge }}</span>{%- endif -%}
            <div class="rv-sg__media">
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 850px) 33vw, 100vw', widths: '400, 600, 800', alt: b.image.alt | default: b.name }}
              {%- else -%}
                {{ 'product-3' | placeholder_svg_tag: 'rv-placeholder' }}
              {%- endif -%}
            </div>
            <div class="rv-sg__body">
              <p class="rv-sg__name">{{ b.name }}{% if b.range != blank %} <small>{{ b.range }}</small>{% endif %}</p>
              {%- if b.text != blank -%}<p class="rv-sg__text">{{ b.text }}</p>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="rv-sg__bottom">
      {%- if rows.size > 0 -%}
        <div class="rv-sg__dims">
          {%- if s.table_title != blank -%}<h3 class="rv-sg__dims-title">{{ s.table_title }}</h3>{%- endif -%}
          <div class="rv-sg__table-wrap" tabindex="0" role="region" aria-label="{{ s.table_title | escape }}">
            <table class="rv-sg__table">
              <thead>
                <tr>
                  <th scope="col">{{ s.col_0 }}</th>
                  {%- if s.col_1 != blank -%}<th scope="col">{{ s.col_1 }}</th>{%- endif -%}
                  {%- if s.col_2 != blank -%}<th scope="col">{{ s.col_2 }}</th>{%- endif -%}
                  {%- if s.col_3 != blank -%}<th scope="col">{{ s.col_3 }}</th>{%- endif -%}
                  {%- if s.col_4 != blank -%}<th scope="col">{{ s.col_4 }}</th>{%- endif -%}
                </tr>
              </thead>
              <tbody>
                {%- for block in rows -%}
                  <tr{% if block.settings.highlight %} class="is-highlight"{% endif %} {{ block.shopify_attributes }}>
                    <th scope="row">{{ block.settings.size }}</th>
                    {%- if s.col_1 != blank -%}<td>{{ block.settings.v1 }}</td>{%- endif -%}
                    {%- if s.col_2 != blank -%}<td>{{ block.settings.v2 }}</td>{%- endif -%}
                    {%- if s.col_3 != blank -%}<td>{{ block.settings.v3 }}</td>{%- endif -%}
                    {%- if s.col_4 != blank -%}<td>{{ block.settings.v4 }}</td>{%- endif -%}
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        </div>
      {%- endif -%}

      {%- if s.video_title != blank or s.video_image != blank -%}
        <article class="rv-vcard">
          {%- if video_src != blank -%}
            <button type="button" class="rv-vcard__media" data-rv-video="{{ video_src }}" data-rv-vertical="{{ s.vertical }}" aria-label="Play video: {{ s.video_title | escape }}">
          {%- else -%}
            <div class="rv-vcard__media">
          {%- endif -%}
            {%- if s.video_image != blank -%}
              {{ s.video_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 850px) 50vw, 100vw', widths: '400, 600, 900', alt: '' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'rv-placeholder' }}
            {%- endif -%}
            <span class="rv-vcard__play"><i>{%- render 'rv-icon', icon: 'play' -%}</i>{{ s.video_label }}</span>
          {%- if video_src != blank -%}</button>{%- else -%}</div>{%- endif -%}
          <div class="rv-vcard__body">
            <h3 class="rv-vcard__title">{{ s.video_title }}</h3>
            {%- if s.video_text != blank -%}<p class="rv-vcard__text">{{ s.video_text }}</p>{%- endif -%}
            {%- if s.video_button != blank and video_src != blank -%}
              <button type="button" class="rv-btn rv-btn--ghost" data-rv-video="{{ video_src }}" data-rv-vertical="{{ s.vertical }}">{{ s.video_button }} {% render 'rv-icon', icon: 'arrow-up-right' %}</button>
            {%- endif -%}
          </div>
        </article>
      {%- endif -%}
    </div>
  </div>
</section>
{% render 'rv-video-modal' %}

{% schema %}
{
  "name": "Reviv size guide",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "The product's \"Size guide\" link jumps here", "default": "size-guide" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Size" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your size" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Width matters most. Bite into a slice of bread and measure the mark from molar to molar — that number picks your size." },
    { "type": "header", "content": "Dimensions table" },
    { "type": "text", "id": "table_title", "label": "Table title", "default": "Dimensions" },
    { "type": "text", "id": "col_0", "label": "Column 1 heading", "default": "Size" },
    { "type": "text", "id": "col_1", "label": "Column 2 heading", "default": "Length" },
    { "type": "text", "id": "col_2", "label": "Column 3 heading", "default": "Width" },
    { "type": "text", "id": "col_3", "label": "Column 4 heading", "default": "Height" },
    { "type": "text", "id": "col_4", "label": "Column 5 heading", "default": "Thick." },
    { "type": "header", "content": "Video card" },
    { "type": "image_picker", "id": "video_image", "label": "Cover image" },
    { "type": "video_url", "id": "video", "label": "YouTube or Vimeo URL", "accept": ["youtube", "vimeo"] },
    { "type": "checkbox", "id": "vertical", "label": "Vertical video (Shorts)", "default": true },
    { "type": "text", "id": "video_label", "label": "Label on cover", "default": "Watch · Short" },
    { "type": "text", "id": "video_title", "label": "Title", "default": "How to measure, in one minute" },
    { "type": "textarea", "id": "video_text", "label": "Text", "default": "The bite-and-bread method, on camera. Still unsure after watching? Email ken@getreviv.com and he will help you pick." },
    { "type": "text", "id": "video_button", "label": "Button label", "default": "Watch video" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "size", "name": "Size card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Size name", "default": "Medium" },
        { "type": "text", "id": "range", "label": "Measurement", "default": "under 6.2 cm" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight this card", "default": false }
      ]
    },
    {
      "type": "row", "name": "Table row",
      "settings": [
        { "type": "text", "id": "size", "label": "Size", "default": "Medium" },
        { "type": "text", "id": "v1", "label": "Column 2" },
        { "type": "text", "id": "v2", "label": "Column 3" },
        { "type": "text", "id": "v3", "label": "Column 4" },
        { "type": "text", "id": "v4", "label": "Column 5" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight row", "default": false }
      ]
    }
  ],
  "presets": [{
    "name": "Reviv size guide",
    "blocks": [
      { "type": "size", "settings": { "name": "Medium", "range": "under 6.2 cm", "text": "Teens and adults with smaller mouths. Slightly narrower and shorter for a more precise fit." } },
      { "type": "size", "settings": { "name": "Large", "range": "6.2 – 7.1 cm", "text": "Suits most adults, and gives a snug, comfortable fit for best effect.", "badge": "Most adults", "highlight": true } },
      { "type": "size", "settings": { "name": "XL", "range": "7.2 cm and up", "text": "For adults with larger mouths. New with R3 — it was not available before." } },
      { "type": "row", "settings": { "size": "Medium", "v1": "46 mm", "v2": "63.5 mm", "v3": "23 mm", "v4": "4.1 mm" } },
      { "type": "row", "settings": { "size": "Large", "v1": "53.6 mm", "v2": "73.2 mm", "v3": "26 mm", "v4": "4.2 mm", "highlight": true } },
      { "type": "row", "settings": { "size": "XL", "v1": "59.6 mm", "v2": "84 mm", "v3": "27 mm", "v4": "5 mm" } }
    ]
  }]
}
{% endschema %}
