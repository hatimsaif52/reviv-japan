{%- liquid
  assign s = section.settings
  assign count = product.metafields.reviews.rating_count.value | default: 0
  assign heading = s.heading | replace: '[count]', count | replace: '[title]', product.title
-%}
<section class="rv-scope rv-section" id="{{ s.anchor | default: 'reviews' }}" style="--rv-pad-top: {{ s.padding_top }}px; --rv-pad-bottom: {{ s.padding_bottom }}px; scroll-margin-top: 20px;" aria-labelledby="rv-ra-{{ section.id }}">
  <div class="rv-container">
    <div class="rv-reviews-app">
      <div class="rv-head">
        <div>
          {%- render 'rv-pill', text: s.eyebrow -%}
          <h2 class="rv-head__title" id="rv-ra-{{ section.id }}">{{ heading }}</h2>
        </div>
      </div>
      {%- for block in section.blocks -%}
        <div class="rv-reviews-app__block" {{ block.shopify_attributes }}>{% render block %}</div>
      {%- else -%}
        {%- if request.design_mode -%}
          <p class="rv-reviews-app__empty">Add the Judge.me “Review Widget” app block to this section (Add block › Apps).</p>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviv reviews (app)",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Review" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "[count] and [title] are replaced with the review count and product title", "default": "[count] reviews of [title]" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "The star rating under the product title jumps here", "default": "reviews" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Reviv reviews (app)" }]
}
{% endschema %}
