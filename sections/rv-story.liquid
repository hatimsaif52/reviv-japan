{%- liquid
  assign s = section.settings
  assign chapters = section.blocks | where: 'type', 'chapter'
-%}
{%- capture nl %}
{% endcapture -%}
<section class="rv-scope rv-section rv-story rv-story--{{ s.accent }}" style="--rv-pad-top: {{ s.padding_top }}px; --rv-pad-bottom: {{ s.padding_bottom }}px;" aria-labelledby="rv-story-{{ section.id }}">
  <div class="rv-container{% if s.inset %} rv-container--inset{% endif %}">
    <div class="rv-story__head">
      {%- if s.eyebrow != blank -%}
        <span class="rv-pill rv-pill--{{ s.accent }}"><span class="rv-pill__star" aria-hidden="true">✦</span>{{ s.eyebrow }}</span>
      {%- endif -%}
      <h2 class="rv-head__title" id="rv-story-{{ section.id }}">{{ s.heading }}</h2>
      {%- if s.intro != blank -%}<p class="rv-story__intro">{{ s.intro }}</p>{%- endif -%}
    </div>

    {%- if s.show_toc and chapters.size > 0 -%}
      <ol class="rv-toc">
        {%- for block in chapters -%}
          <li><a href="#rv-ch-{{ block.id }}"><span class="rv-toc__num">{{ block.settings.number }}</span><span class="rv-toc__title">{{ block.settings.toc_title | default: block.settings.title }}</span><span class="rv-toc__line" aria-hidden="true"></span></a></li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- for block in chapters -%}
      {%- liquid
        assign b = block.settings
        assign has_media = false
        if b.image != blank or b.video != blank or b.video_url != blank
          assign has_media = true
        endif
        assign items = b.items | split: nl
      -%}
      <article class="rv-chapter{% if b.divider %} has-divider{% endif %}{% if has_media %} has-media is-media-{{ b.media_position }}{% endif %}" id="rv-ch-{{ block.id }}" {{ block.shopify_attributes }}>
        <div class="rv-chapter__body">
          {%- if b.number != blank -%}<p class="rv-chapter__num" aria-hidden="true">{{ b.number }}</p>{%- endif -%}
          <h3 class="rv-chapter__title">{{ b.title }}</h3>
          {%- if b.text != blank -%}<div class="rv-chapter__text">{{ b.text }}</div>{%- endif -%}

          {%- if b.items != blank -%}
            {%- case b.list_style -%}
              {%- when 'numbered' -%}
                <ol class="rv-list-num">
                  {%- assign n = 0 -%}
                  {%- for it in items -%}{%- assign it = it | strip -%}{%- if it != blank -%}{%- assign n = n | plus: 1 -%}
                    <li><span>{% if n < 10 %}0{% endif %}{{ n }}</span>{{ it }}</li>
                  {%- endif -%}{%- endfor -%}
                </ol>
              {%- when 'crosses' -%}
                <ul class="rv-list-cross">
                  {%- for it in items -%}{%- assign it = it | strip -%}{%- if it != blank -%}
                    <li>{%- render 'rv-icon', icon: 'close' -%}{{ it }}</li>
                  {%- endif -%}{%- endfor -%}
                </ul>
              {%- else -%}
                <ul class="rv-list-grid">
                  {%- for it in items -%}{%- assign it = it | strip -%}{%- if it != blank -%}
                    <li>{{ it }}</li>
                  {%- endif -%}{%- endfor -%}
                </ul>
            {%- endcase -%}
          {%- endif -%}

          {%- if b.concept_1_word != blank or b.concept_2_word != blank -%}
            <div class="rv-concepts">
              {%- if b.concept_1_word != blank -%}
                <div class="rv-concept">
                  <p class="rv-concept__word" style="color: {{ b.concept_1_color }};">{{ b.concept_1_word }}</p>
                  {%- if b.concept_1_label != blank -%}<p class="rv-concept__label">{{ b.concept_1_label }}</p>{%- endif -%}
                  {%- if b.concept_1_text != blank -%}<p class="rv-concept__text">{{ b.concept_1_text }}</p>{%- endif -%}
                </div>
              {%- endif -%}
              {%- if b.concept_2_word != blank -%}
                <div class="rv-concept">
                  <p class="rv-concept__word" style="color: {{ b.concept_2_color }};">{{ b.concept_2_word }}</p>
                  {%- if b.concept_2_label != blank -%}<p class="rv-concept__label">{{ b.concept_2_label }}</p>{%- endif -%}
                  {%- if b.concept_2_text != blank -%}<p class="rv-concept__text">{{ b.concept_2_text }}</p>{%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if b.note != blank -%}<p class="rv-chapter__note">{{ b.note }}</p>{%- endif -%}
        </div>

        {%- if has_media -%}
          <figure class="rv-chapter__media{% if b.media_frame %} is-framed{% endif %}">
            <div class="rv-chapter__frame">
              {%- if b.video != blank -%}
                {{ b.video | video_tag: controls: true, playsinline: true, preload: 'metadata', image_size: '1200x' }}
              {%- elsif b.video_url != blank -%}
                {%- if b.video_url.type == 'youtube' -%}
                  <iframe src="https://www.youtube-nocookie.com/embed/{{ b.video_url.id }}?rel=0" title="{{ b.title | escape }}" loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe>
                {%- else -%}
                  <iframe src="https://player.vimeo.com/video/{{ b.video_url.id }}" title="{{ b.title | escape }}" loading="lazy" allow="picture-in-picture" allowfullscreen></iframe>
                {%- endif -%}
              {%- else -%}
                {{ b.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 100vw', widths: '400, 600, 800, 1000, 1200', alt: b.image.alt | default: b.caption }}
              {%- endif -%}
            </div>
            {%- if b.caption != blank -%}<figcaption>{{ b.caption }}</figcaption>{%- endif -%}
          </figure>
        {%- endif -%}
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviv numbered story",
  "tag": "div",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The problem" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why we think this keeps happening" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Reviv started from a hypothesis about structure rather than symptoms — set out here in the order we arrived at it." },
    { "type": "select", "id": "accent", "label": "Accent colour", "default": "gold", "info": "Colour of the big numbers and the eyebrow tint", "options": [
      { "value": "gold", "label": "Gold" }, { "value": "red", "label": "Red (eyebrow) + gold numbers" }, { "value": "green", "label": "Green" }
    ]},
    { "type": "checkbox", "id": "show_toc", "label": "Show contents list", "default": true },
    { "type": "checkbox", "id": "inset", "label": "Narrower, indented layout", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [{
    "type": "chapter", "name": "Chapter",
    "settings": [
      { "type": "text", "id": "number", "label": "Number", "default": "01" },
      { "type": "text", "id": "title", "label": "Title", "default": "Chapter title" },
      { "type": "text", "id": "toc_title", "label": "Short title for contents list" },
      { "type": "checkbox", "id": "divider", "label": "Line above chapter", "default": false },
      { "type": "richtext", "id": "text", "label": "Text" },
      { "type": "header", "content": "List" },
      { "type": "select", "id": "list_style", "label": "List style", "default": "grid", "options": [
        { "value": "grid", "label": "Dots in a grid" }, { "value": "crosses", "label": "Crosses in a row" }, { "value": "numbered", "label": "Numbered lines" }
      ]},
      { "type": "textarea", "id": "items", "label": "List items", "info": "One per line" },
      { "type": "header", "content": "Media" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "video", "id": "video", "label": "Video (uploaded)", "info": "Replaces the image" },
      { "type": "video_url", "id": "video_url", "label": "Or YouTube / Vimeo URL", "accept": ["youtube", "vimeo"] },
      { "type": "select", "id": "media_position", "label": "Media position", "default": "right", "options": [
        { "value": "right", "label": "Right" }, { "value": "left", "label": "Left" }
      ]},
      { "type": "checkbox", "id": "media_frame", "label": "White frame around media", "default": true },
      { "type": "text", "id": "caption", "label": "Caption" },
      { "type": "header", "content": "Two concepts (optional)" },
      { "type": "text", "id": "concept_1_word", "label": "Concept 1 word", "info": "e.g. 収縮" },
      { "type": "text", "id": "concept_1_label", "label": "Concept 1 label", "info": "e.g. Deflating" },
      { "type": "textarea", "id": "concept_1_text", "label": "Concept 1 text" },
      { "type": "color", "id": "concept_1_color", "label": "Concept 1 colour", "default": "#b5553a" },
      { "type": "text", "id": "concept_2_word", "label": "Concept 2 word" },
      { "type": "text", "id": "concept_2_label", "label": "Concept 2 label" },
      { "type": "textarea", "id": "concept_2_text", "label": "Concept 2 text" },
      { "type": "color", "id": "concept_2_color", "label": "Concept 2 colour", "default": "#2d6a5e" },
      { "type": "text", "id": "note", "label": "Note under the chapter" }
    ]
  }],
  "presets": [{
    "name": "Reviv numbered story",
    "blocks": [
      { "type": "chapter", "settings": { "number": "01", "toc_title": "More health issues than ever before", "title": "People today are having more physical and mental health issues than ever before", "list_style": "grid", "items": "Postural issues\nDepression and anxiety\nChronic fatigue and poor energy\nADHD, OCD and similar\nObesity", "caption": "Reported growth in physical and mental health issues, 1950–2024. Log scale." } },
      { "type": "chapter", "settings": { "number": "02", "toc_title": "Traditional approaches falling short", "title": "And the traditional ways of fighting them are falling way short", "list_style": "crosses", "items": "Pharmaceuticals\nDiet and eating healthy\nExercise\nMedical procedures" } },
      { "type": "chapter", "settings": { "number": "03", "toc_title": "A structural root cause", "title": "So we believe there may be a structural root cause", "list_style": "numbered", "media_position": "left", "items": "There is a set of physics that holds the body up, and the teeth play a critical role in it\nBecause of those physics, the skull can collapse inwards as the teeth change\nThe health of the skull shows up in the curve of Spee — how the upper and lower teeth meet\nOrthodontics, extractions and grinding all flatten that curve", "caption": "The curve of Spee — how the upper and lower teeth meet." } },
      { "type": "chapter", "settings": { "number": "04", "toc_title": "The skull can be inflated", "title": "We believe the skull can be inflated like a ball", "divider": true, "concept_1_word": "収縮", "concept_1_label": "Deflating", "concept_1_text": "What we believe causes aging and asymmetry, and sits at the root of most disease", "concept_2_word": "膨張", "concept_2_label": "Inflating", "concept_2_text": "Reverses those things — and a mouthguard can help do it", "note": "As the skull inflates, the curve of Spee improves.", "media_frame": false } }
    ]
  }]
}
{% endschema %}
