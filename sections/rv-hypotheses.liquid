{%- assign s = section.settings -%}
<section class="rv-scope rv-section" style="--rv-pad-top: {{ s.padding_top }}px; --rv-pad-bottom: {{ s.padding_bottom }}px;" aria-labelledby="rv-hyp-{{ section.id }}">
  <div class="rv-container{% if s.inset %} rv-container--inset{% endif %}">
    <div class="rv-hyp__head">
      <h2 class="rv-hyp__title" id="rv-hyp-{{ section.id }}">
        {%- if s.label != blank -%}<span class="rv-hyp__label">{{ s.label }}</span>{%- endif -%}
        {{ s.heading }}
      </h2>
      {%- if s.subheading != blank -%}<p class="rv-head__sub">{{ s.subheading }}</p>{%- endif -%}
    </div>
    <div class="rv-hyp__grid">
      {%- for block in section.blocks -%}
        <div class="rv-hyp" {{ block.shopify_attributes }}>
          <div class="rv-hyp__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '400, 600, 800', alt: block.settings.image.alt | default: block.settings.title }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'rv-placeholder' }}
            {%- endif -%}
          </div>
          <p class="rv-hyp__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</p>
          <h3 class="rv-hyp__name">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="rv-hyp__text">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if s.disclaimer != blank -%}<div class="rv-hyp__note">{{ s.disclaimer }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviv hypotheses",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "label", "label": "Small label before heading", "default": "仮説" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three hypotheses we are testing" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Open questions about the future of biomechanics — not claims." },
    { "type": "richtext", "id": "disclaimer", "label": "Disclaimer", "default": "<p>These are Reviv's own hypotheses, based on personal experience and educational in nature. They have not been evaluated by the PMDA, and Reviv makes no claim to diagnose, treat, cure or prevent any disease.</p>" },
    { "type": "checkbox", "id": "inset", "label": "Narrower, indented layout", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [{
    "type": "card", "name": "Hypothesis",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Title", "default": "Hypothesis" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ]
  }],
  "presets": [{
    "name": "Reviv hypotheses",
    "blocks": [
      { "type": "card", "settings": { "title": "Root cause of almost all disease", "text": "Is disease a function of biomechanical collapse?" } },
      { "type": "card", "settings": { "title": "Root cause of aging", "text": "If we do not collapse, maybe we do not age the way we assume we must." } },
      { "type": "card", "settings": { "title": "Root cause of beauty", "text": "How far does this go if you take it all the way?" } }
    ]
  }]
}
{% endschema %}
