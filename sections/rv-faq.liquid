{%- assign s = section.settings -%}
<section class="rv-scope rv-section" style="--rv-pad-top: {{ s.padding_top }}px; --rv-pad-bottom: {{ s.padding_bottom }}px;" aria-labelledby="rv-faq-{{ section.id }}">
  <div class="rv-container rv-faq">
    <div class="rv-head">
      <div>
        {%- render 'rv-pill', text: s.eyebrow -%}
        <h2 class="rv-head__title" id="rv-faq-{{ section.id }}">{{ s.heading }}</h2>
      </div>
    </div>
    <div class="rv-faq__list">
      {%- for block in section.blocks -%}
        <details class="rv-faq__item"{% if forloop.first and s.open_first %} open{% endif %} {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question }}</span>
            <i class="rv-faq__icon" aria-hidden="true"><span class="rv-faq__plus">{% render 'rv-icon', icon: 'plus' %}</span><span class="rv-faq__minus">{% render 'rv-icon', icon: 'minus' %}</span></i>
          </summary>
          <div class="rv-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- if s.schema_markup and section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
        {%- for block in section.blocks -%}
          {"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]}
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Reviv FAQ",
  "tag": "div",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    { "type": "checkbox", "id": "schema_markup", "label": "Add FAQ structured data for Google", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [{
    "type": "question", "name": "Question",
    "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
    ]
  }],
  "presets": [{
    "name": "Reviv FAQ",
    "blocks": [
      { "type": "question", "settings": { "question": "How should I start? Is there anything to be aware of?", "answer": "<p>The standard pattern is overnight plus 2–3 hours during the day. Build up gradually with shorter daytime intervals first rather than going straight to overnights — that helps the soft tissue adjust. Most people find the first few weeks the hardest part, and it gets significantly easier after that.</p>" } },
      { "type": "question", "settings": { "question": "Is early discomfort normal?" } },
      { "type": "question", "settings": { "question": "How does sizing work?" } },
      { "type": "question", "settings": { "question": "What does the support package include?" } },
      { "type": "question", "settings": { "question": "What is it made of, and how long does it last?" } },
      { "type": "question", "settings": { "question": "Shipping and returns" } }
    ]
  }]
}
{% endschema %}
