{%- if section.settings.text != blank -%}
<div class="rv-scope rv-announce" role="region" aria-label="Announcement">
  {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
  <span class="rv-announce__inner">
    {%- if section.settings.tag != blank -%}<span class="rv-announce__tag">{{ section.settings.tag }}</span>{%- endif -%}
    <span>{{ section.settings.text }}{% if section.settings.link != blank %} →{% endif %}</span>
  </span>
  {%- if section.settings.link != blank -%}</a>{%- endif -%}
</div>
<style>
  #shopify-section-{{ section.id }} .rv-announce { background: {{ section.settings.bg }}; }
  #shopify-section-{{ section.id }} .rv-announce__tag { color: {{ section.settings.bg }}; }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Reviv announcement",
  "class": "rv-announcement-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "tag", "label": "Tag", "default": "NEW" },
    { "type": "text", "id": "text", "label": "Text", "default": "R3 RevivThree has launched — our gentlest appliance yet, now in size XL" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#c6442a" }
  ],
  "presets": [{ "name": "Reviv announcement" }]
}
{% endschema %}
