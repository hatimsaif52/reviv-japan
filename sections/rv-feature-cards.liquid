{%- assign s = section.settings -%}
<section class="rv-scope rv-section" style="--rv-pad-top: {{ s.padding_top }}px; --rv-pad-bottom: {{ s.padding_bottom }}px;" aria-labelledby="rv-fc-{{ section.id }}">
  <div class="rv-container">
    <div class="rv-head">
      <div>
        {%- render 'rv-pill', text: s.eyebrow -%}
        <h2 class="rv-head__title" id="rv-fc-{{ section.id }}">{{ s.heading }}</h2>
        {%- if s.subheading != blank -%}<p class="rv-head__sub">{{ s.subheading }}</p>{%- endif -%}
      </div>
    </div>
    <div class="rv-fcards" style="--rv-cols: {{ s.columns }};">
      {%- for block in section.blocks -%}
        <div class="rv-fcard" {{ block.shopify_attributes }}>
          <span class="rv-fcard__icon">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {%- render 'rv-icon', icon: block.settings.icon -%}
            {%- endif -%}
          </span>
          <h3 class="rv-fcard__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="rv-fcard__text">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviv icon cards",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Who it is for" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Is R3 the right one for you?" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [{
    "type": "card", "name": "Card",
    "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "sparkle", "options": [
        { "value": "sparkle", "label": "Sparkle" }, { "value": "heart", "label": "Heart" }, { "value": "moon", "label": "Moon" },
        { "value": "shield", "label": "Shield" }, { "value": "leaf", "label": "Leaf" }, { "value": "smile", "label": "Smile" },
        { "value": "clock", "label": "Clock" }, { "value": "star", "label": "Star" }, { "value": "home", "label": "Home" }
      ]},
      { "type": "image_picker", "id": "image", "label": "Custom icon image", "info": "Optional. Replaces the icon above." },
      { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ]
  }],
  "presets": [{
    "name": "Reviv icon cards",
    "blocks": [
      { "type": "card", "settings": { "icon": "sparkle", "title": "New to Reviv", "text": "The low-cut profile is the easiest of the three to sleep in, so most people start here rather than with R1 or R2." } },
      { "type": "card", "settings": { "icon": "heart", "title": "Sensitive gums", "text": "R3 sits lower on the gum line and applies the least pressure of any Reviv appliance." } },
      { "type": "card", "settings": { "icon": "moon", "title": "Long-term nightly use", "text": "Built to be worn every night for about a year, plus a few hours during the day when you can." } }
    ]
  }]
}
{% endschema %}
