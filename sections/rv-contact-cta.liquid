{%- assign s = section.settings -%}
<section class="rv-scope rv-section" style="--rv-pad-top: {{ s.padding_top }}px; --rv-pad-bottom: {{ s.padding_bottom }}px;" aria-labelledby="rv-cta-{{ section.id }}">
  <div class="rv-container">
    <div class="rv-cta">
      <h2 class="rv-cta__title" id="rv-cta-{{ section.id }}">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<div class="rv-cta__text">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank -%}
        {%- liquid
          assign link = s.button_link
          if link == blank
            assign email = s.button_label | strip
            if email contains '@'
              assign link = 'mailto:' | append: email
            else
              assign link = 'mailto:' | append: shop.email
            endif
          endif
        -%}
        <a href="{{ link }}" class="rv-btn rv-btn--primary rv-btn--lg rv-cta__btn">{{ s.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviv contact card",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still not sure which one?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Email us with what matters most to you — comfort, airflow, grinding or budget — and we will recommend the right appliance.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "cs@getreviv.com"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave blank to email the address shown in the button label (or your store email). You can also paste a mailto: link or any page."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Reviv contact card"
    }
  ]
}
{% endschema %}
