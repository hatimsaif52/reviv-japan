{%- assign s = section.settings -%}
{%- capture nl %}
{% endcapture -%}
<section class="rv-scope rv-section" style="--rv-pad-top: {{ s.padding_top }}px; --rv-pad-bottom: {{ s.padding_bottom }}px;" aria-labelledby="rv-tl-{{ section.id }}">
  <div class="rv-container rv-timeline">
    <div class="rv-head">
      <div>
        {%- render 'rv-pill', text: s.eyebrow -%}
        <h2 class="rv-head__title" id="rv-tl-{{ section.id }}">{{ s.heading }}</h2>
        {%- if s.subheading != blank -%}<p class="rv-head__sub">{{ s.subheading }}</p>{%- endif -%}
      </div>
    </div>
    <ol class="rv-timeline__grid">
      {%- for block in section.blocks -%}
        {%- assign items = block.settings.items | split: nl -%}
        <li class="rv-stage" {{ block.shopify_attributes }}>
          <h3 class="rv-stage__title"><span class="rv-stage__dot" style="background: {{ block.settings.color }};" aria-hidden="true"></span>{{ block.settings.title }}</h3>
          <ul class="rv-stage__list">
            {%- for it in items -%}{%- assign it = it | strip -%}{%- if it != blank -%}<li>{{ it }}</li>{%- endif -%}{%- endfor -%}
          </ul>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Reviv timeline",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Timeline" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What to expect" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "What customers commonly report as they go through the process. This is shared experience, not a promise — everyone is different." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [{
    "type": "stage", "name": "Stage",
    "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "1 week" },
      { "type": "color", "id": "color", "label": "Dot colour", "default": "#c6442a" },
      { "type": "textarea", "id": "items", "label": "Points", "info": "One per line" }
    ]
  }],
  "presets": [{
    "name": "Reviv timeline",
    "blocks": [
      { "type": "stage", "settings": { "title": "1 week", "color": "#c6442a", "items": "Some initial discomfort in the teeth and gums\nA few nights to get used to sleeping with it" } },
      { "type": "stage", "settings": { "title": "1 month", "color": "#e07a3f", "items": "It starts to feel more comfortable\nDifferences in how the teeth fit together\nMany wake without the tight, clenched feeling" } },
      { "type": "stage", "settings": { "title": "1 year", "color": "#c1913d", "items": "Better concentration and stamina, many report\nMore energy through the day" } },
      { "type": "stage", "settings": { "title": "2 years+", "color": "#2d6a5e", "items": "The appliance plateaus; the community stretches carry it on\nSteady improvement, functionally and aesthetically" } }
    ]
  }]
}
{% endschema %}
