{%- liquid
  assign s = section.settings
  assign target = ''
  if s.new_tab
    assign target = ' target="_blank" rel="noopener"'
  endif
-%}
<section class="rv-scope rv-section" style="--rv-pad-top: {{ s.padding_top }}px; --rv-pad-bottom: {{ s.padding_bottom }}px;" aria-labelledby="rv-substack-{{ section.id }}">
  <div class="rv-container">
    <div class="rv-head">
      <div>
        {%- render 'rv-pill', text: s.eyebrow -%}
        <h2 class="rv-head__title" id="rv-substack-{{ section.id }}">{{ s.heading }}</h2>
      </div>
      {%- if s.button_label != blank -%}
        <a href="{{ s.button_link | default: '#' }}" class="rv-btn rv-btn--ghost"{{ target }}>{{ s.button_label }}</a>
      {%- endif -%}
    </div>

    <div class="rv-journal__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- if b.link != blank -%}
          <a href="{{ b.link }}" class="rv-post"{{ target }} {{ block.shopify_attributes }}>
        {%- else -%}
          <div class="rv-post" {{ block.shopify_attributes }}>
        {%- endif -%}
          <div class="rv-post__media">
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, (min-width: 520px) 50vw, 100vw', widths: '300, 450, 600', alt: b.image.alt | default: b.title }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'rv-placeholder' }}
            {%- endif -%}
          </div>
          <div class="rv-post__body">
            {%- if b.date != blank -%}<span class="rv-post__date">{{ b.date }}</span>{%- endif -%}
            <h3 class="rv-post__title">{{ b.title }}</h3>
            {%- if b.tags != blank -%}
              {%- assign tags = b.tags | split: ',' -%}
              <div class="rv-post__tags">
                {%- for tag in tags -%}
                  {%- assign t = tag | strip -%}
                  {%- if t != blank -%}<span>{{ t }}</span>{%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- if b.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviv Substack posts",
  "tag": "div",
  "max_blocks": 8,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Article" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the journal" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all articles" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Your Substack homepage, e.g. https://yourname.substack.com" },
    { "type": "checkbox", "id": "new_tab", "label": "Open links in a new tab", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [{
    "type": "post", "name": "Substack post",
    "settings": [
      { "type": "url", "id": "link", "label": "Substack post link" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "date", "label": "Date", "info": "Shown exactly as typed, e.g. 2024.06.23", "default": "2024.06.23" },
      { "type": "text", "id": "title", "label": "Title", "default": "Post title" },
      { "type": "text", "id": "tags", "label": "Tags", "info": "Separate with commas, e.g. health, biomechanics", "default": "health, biomechanics" }
    ]
  }],
  "presets": [{
    "name": "Reviv Substack posts",
    "blocks": [
      { "type": "post", "settings": { "date": "2024.06.23", "title": "I Am Going to Challenge What You Believe About Health", "tags": "health, biomechanics" } },
      { "type": "post", "settings": { "date": "2024.06.26", "title": "The Balloon Theory", "tags": "theory, dental" } },
      { "type": "post", "settings": { "date": "2024.06.27", "title": "How to Correct the Problem", "tags": "care, how-to" } },
      { "type": "post", "settings": { "date": "2024.07.25", "title": "What Is Impacted by These Biomechanics?", "tags": "biomechanics" } }
    ]
  }]
}
{% endschema %}
