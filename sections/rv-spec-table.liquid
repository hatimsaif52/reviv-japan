{%- liquid
  assign s = section.settings
  assign featured = s.featured_column | plus: 0
-%}
<section class="rv-scope rv-section" id="{{ s.anchor | default: 'comparison' }}" style="--rv-pad-top: {{ s.padding_top }}px; --rv-pad-bottom: {{ s.padding_bottom }}px; scroll-margin-top: 20px;" aria-labelledby="rv-spec-{{ section.id }}">
  <div class="rv-container">
    <div class="rv-head">
      <div>
        {%- render 'rv-pill', text: s.eyebrow -%}
        <h2 class="rv-head__title" id="rv-spec-{{ section.id }}">{{ s.heading }}</h2>
        {%- if s.subheading != blank -%}<p class="rv-head__sub rv-choice__sub">{{ s.subheading }}</p>{%- endif -%}
      </div>
    </div>

    <div class="rv-spec__scroll" tabindex="0" role="region" aria-label="{{ s.heading | escape }}">
      <table class="rv-spec">
        <thead>
          <tr>
            <td></td>
            {%- for i in (1..3) -%}
              {%- liquid
                assign ikey = 'image_' | append: i
                assign nkey = 'name_' | append: i
                assign skey = 'sub_' | append: i
                assign lkey = 'link_' | append: i
              -%}
              {%- if s[nkey] != blank -%}
                <th scope="col"{% if i == featured %} class="is-featured"{% endif %}>
                  <a class="rv-spec__head" href="{{ s[lkey] | default: '#' }}"{% if s[lkey] == blank %} tabindex="-1"{% endif %}>
                    <span class="rv-spec__thumb">
                      {%- if s[ikey] != blank -%}
                        {{ s[ikey] | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
                      {%- else -%}
                        {{ 'product-2' | placeholder_svg_tag: 'rv-placeholder' }}
                      {%- endif -%}
                    </span>
                    <span class="rv-spec__name">{{ s[nkey] }}</span>
                    {%- if i == featured and s.featured_label != blank -%}
                      <span class="rv-spec__sub is-accent">{{ s.featured_label }}</span>
                    {%- elsif s[skey] != blank -%}
                      <span class="rv-spec__sub">{{ s[skey] }}</span>
                    {%- endif -%}
                  </a>
                </th>
              {%- endif -%}
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr{% if block.settings.emphasis %} class="is-emphasis"{% endif %} {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label }}</th>
              {%- for i in (1..3) -%}
                {%- liquid
                  assign nkey = 'name_' | append: i
                  if s[nkey] == blank
                    continue
                  endif
                  assign vkey = 'value_' | append: i
                  assign pkey = 'popup_' | append: i
                  assign raw = block.settings[vkey] | strip
                  assign v_low = raw | downcase
                  assign bold = false
                  assign first = raw | slice: 0
                  if first == '*'
                    assign bold = true
                    assign raw = raw | remove_first: '*' | strip
                  endif
                  assign popup = block.settings[pkey]
                  assign dlg = 'rv-spec-dlg-' | append: block.id | append: '-' | append: i
                -%}
                <td{% if i == featured %} class="is-featured"{% endif %}>
                  {%- if popup != blank -%}
                    <button type="button" class="rv-btn rv-btn--ghost rv-spec__guide" data-rv-dialog-open="{{ dlg }}">{{ raw | default: s.popup_button }} {% render 'rv-icon', icon: 'arrow-up-right' %}</button>
                    <dialog class="rv-scope rv-dialog rv-dialog--wide" id="{{ dlg }}" aria-label="{{ raw | default: block.settings.label | escape }}">
                      <div class="rv-dialog__inner">
                        <button type="button" class="rv-dialog__close" data-rv-dialog-close aria-label="Close">{%- render 'rv-icon', icon: 'close' -%}</button>
                        <div class="rv-dialog__body rv-rte">{{ popup }}</div>
                      </div>
                    </dialog>
                  {%- elsif v_low == 'yes' -%}
                    <span class="rv-spec__mark is-yes" role="img" aria-label="{{ s.legend_yes | escape }}">{% render 'rv-icon', icon: 'ring' %}</span>
                  {%- elsif v_low == 'no' -%}
                    <span class="rv-spec__mark is-no" role="img" aria-label="{{ s.legend_no | escape }}">{% render 'rv-icon', icon: 'close' %}</span>
                  {%- elsif bold -%}
                    <strong>{{ raw }}</strong>
                  {%- else -%}
                    {{ raw }}
                  {%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if s.legend_yes != blank or s.legend_no != blank -%}
      <ul class="rv-spec__legend">
        {%- if s.legend_yes != blank -%}<li><span class="rv-spec__mark is-yes">{% render 'rv-icon', icon: 'ring' %}</span>{{ s.legend_yes }}</li>{%- endif -%}
        {%- if s.legend_no != blank -%}<li><span class="rv-spec__mark is-no">{% render 'rv-icon', icon: 'close' %}</span>{{ s.legend_no }}</li>{%- endif -%}
      </ul>
    {%- endif -%}
  </div>
  <script>
    (function () {
      var root = document.getElementById({{ s.anchor | default: 'comparison' | json }});
      if (!root || root.__rvDlg) return; root.__rvDlg = true;
      root.addEventListener('click', function (e) {
        var o = e.target.closest('[data-rv-dialog-open]');
        if (o) { var d = document.getElementById(o.getAttribute('data-rv-dialog-open')); if (d && d.showModal) d.showModal(); return; }
        var d2 = e.target.closest('dialog');
        if (d2 && (e.target === d2 || e.target.closest('[data-rv-dialog-close]'))) d2.close();
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Reviv spec table",
  "tag": "div",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "Buttons linking to #comparison jump here", "default": "comparison" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Side by side" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Every specification in one table. Prices are tax-inclusive; scroll sideways on a narrow screen." },
    { "type": "header", "content": "Columns" },
    { "type": "image_picker", "id": "image_1", "label": "Column 1 image" },
    { "type": "text", "id": "name_1", "label": "Column 1 name", "default": "R1" },
    { "type": "text", "id": "sub_1", "label": "Column 1 sub-name", "default": "RevivOne" },
    { "type": "url", "id": "link_1", "label": "Column 1 link" },
    { "type": "image_picker", "id": "image_2", "label": "Column 2 image" },
    { "type": "text", "id": "name_2", "label": "Column 2 name", "default": "R2" },
    { "type": "text", "id": "sub_2", "label": "Column 2 sub-name", "default": "RevivTwo" },
    { "type": "url", "id": "link_2", "label": "Column 2 link" },
    { "type": "image_picker", "id": "image_3", "label": "Column 3 image" },
    { "type": "text", "id": "name_3", "label": "Column 3 name", "info": "Leave blank to show only two columns", "default": "R3" },
    { "type": "text", "id": "sub_3", "label": "Column 3 sub-name", "default": "RevivThree" },
    { "type": "url", "id": "link_3", "label": "Column 3 link" },
    { "type": "select", "id": "featured_column", "label": "Highlighted column", "default": "3", "options": [
      { "value": "0", "label": "None" }, { "value": "1", "label": "Column 1" }, { "value": "2", "label": "Column 2" }, { "value": "3", "label": "Column 3" }
    ]},
    { "type": "text", "id": "featured_label", "label": "Highlighted column label", "info": "Replaces its sub-name", "default": "おすすめ · Recommended" },
    { "type": "header", "content": "Cells" },
    { "type": "paragraph", "content": "Type yes or no in a cell to show ○ or ×. Start a value with * to make it bold. Add popup content to a cell to turn it into a button that opens a popup (e.g. size guides)." },
    { "type": "text", "id": "popup_button", "label": "Popup button label if the cell is empty", "default": "Guide" },
    { "type": "text", "id": "legend_yes", "label": "Legend: ○", "default": "Suitable" },
    { "type": "text", "id": "legend_no", "label": "Legend: ×", "default": "Not suitable" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [{
    "type": "row", "name": "Row",
    "settings": [
      { "type": "text", "id": "label", "label": "Row label", "default": "Feature" },
      { "type": "checkbox", "id": "emphasis", "label": "Emphasise this row (larger, bold values)", "default": false },
      { "type": "text", "id": "value_1", "label": "Column 1" },
      { "type": "html", "id": "popup_1", "label": "Column 1 popup content" },
      { "type": "text", "id": "value_2", "label": "Column 2" },
      { "type": "html", "id": "popup_2", "label": "Column 2 popup content" },
      { "type": "text", "id": "value_3", "label": "Column 3" },
      { "type": "html", "id": "popup_3", "label": "Column 3 popup content" }
    ]
  }],
  "presets": [{ "name": "Reviv spec table", "blocks": [{ "type": "row" }, { "type": "row" }] }]
}
{% endschema %}
