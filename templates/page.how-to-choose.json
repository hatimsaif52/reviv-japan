    "faq": {
      "type": "rv-faq",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "How is R3 different from R1 and R2? Can I start with R3?",
            "answer": "<p>R3 is designed to be gentler on gums and to support better airflow, making it a popular starting choice for many customers. Yes, you can absolutely start with R3. Our appliances do not go in any particular order.</p>"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Do I need to buy R1 first, then R2, then R3?",
            "answer": "<p>No. Start with the appliance that matches your needs and your comfort. They are not meant to be used sequentially.</p>"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "What is the guarantee?",
            "answer": "<p>R1 has no guarantee. Both R2 and R3 are guaranteed for one year with one free replacement. This replacement warranty is limited to one user per customer and doesn't cover repeat purchases of the same appliance.</p>"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "I am still unsure — what should I do?",
            "answer": "<p>Contact support at <a href=\"mailto:cs@getreviv.com\">cs@getreviv.com</a> with your goals (comfort, airflow, grinding, budget) and we'll recommend the best option.</p>"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "Can I add the support package later?",
            "answer": "<p>Yes. The appliance works on its own, and support can be added at any time after your purchase.</p>"
          }
        },
