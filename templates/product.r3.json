    "solution": {
      "type": "rv-story",
      "blocks": {
        "chapter_1": {
          "type": "chapter",
          "settings": {
            "number": "01",
            "title": "A simple mouthguard addresses that collapse at its root",
            "toc_title": "",
            "divider": false,
            "text": "",
            "list_style": "numbered",
            "items": "The appliance acts like a doorstop that prevents the jaw from closing\nThat stretches the soft tissue in the mouth and over the skull\nAs the soft tissue stretches, we believe the skull inflates and the skeleton untwists",
            "video_url": "",
            "media_position": "right",
            "media_frame": false,
            "caption": "",
            "concept_1_word": "",
            "concept_1_label": "",
            "concept_1_text": "",
            "concept_1_color": "#b5553a",
            "concept_2_word": "",
            "concept_2_label": "",
            "concept_2_text": "",
            "concept_2_color": "#2d6a5e",
            "note": ""
          }
        },
        "chapter_2": {
          "type": "chapter",
          "settings": {
            "number": "02",
            "title": "The teeth correct as a function of the skull correcting",
            "toc_title": "",
            "divider": false,
            "text": "",
            "list_style": "numbered",
            "items": "The cranial bones move outwards into better symmetry and the jaw moves to where it should be\nThe teeth are connected to those bones, so they go for the ride and straighten as a result\nThe body should function better, and feel stronger and more flexible",
            "video_url": "",
            "media_position": "left",
            "media_frame": false,
            "caption": "",
            "concept_1_word": "",
            "concept_1_label": "",
            "concept_1_text": "",
