    "problem": {
      "type": "rv-story",
      "blocks": {
        "chapter_1": {
          "type": "chapter",
          "settings": {
            "number": "01",
            "title": "People today are having more physical and mental health issues than ever before",
            "toc_title": "More health issues than ever before",
            "divider": false,
            "text": "",
            "list_style": "grid",
            "items": "Postural issues\nDepression and anxiety\nChronic fatigue and poor energy\nADHD, OCD and similar\nObesity",
            "video_url": "",
            "media_position": "right",
            "media_frame": true,
            "caption": "Reported growth in physical and mental health issues, 1950–2024. Log scale.",
            "concept_1_word": "",
            "concept_1_label": "",
            "concept_1_text": "",
            "concept_1_color": "#b5553a",
            "concept_2_word": "",
            "concept_2_label": "",
            "concept_2_text": "",
            "concept_2_color": "#2d6a5e",
            "note": ""
          }
        },
        "chapter_2": {
          "type": "chapter",
          "settings": {
            "number": "02",
            "title": "And the traditional ways of fighting them are falling way short",
            "toc_title": "Traditional approaches falling short",
            "divider": false,
            "text": "",
            "list_style": "crosses",
            "items": "Pharmaceuticals\nDiet and eating healthy\nExercise\nMedical procedures",
            "video_url": "",
            "media_position": "right",
            "media_frame": true,
            "caption": "",
            "concept_1_word": "",
            "concept_1_label": "",
            "concept_1_text": "",
            "concept_1_color": "#b5553a",
            "concept_2_word": "",
            "concept_2_label": "",
            "concept_2_text": "",
            "concept_2_color": "#2d6a5e",
            "note": ""
          }
        },
        "chapter_3": {
          "type": "chapter",
          "settings": {
            "number": "03",
            "title": "So we believe there may be a structural root cause",
            "toc_title": "A structural root cause",
            "divider": false,
            "text": "",
            "list_style": "numbered",
            "items": "There is a set of physics that holds the body up, and the teeth play a critical role in it\nBecause of those physics, the skull can collapse inwards as the teeth change\nThe health of the skull shows up in the curve of Spee — how the upper and lower teeth meet\nOrthodontics, extractions and grinding all flatten that curve",
            "video_url": "",
            "media_position": "left",
            "media_frame": true,
            "caption": "The curve of Spee — how the upper and lower teeth meet.",
            "concept_1_word": "",
            "concept_1_label": "",
            "concept_1_text": "",
            "concept_1_color": "#b5553a",
            "concept_2_word": "",
            "concept_2_label": "",
            "concept_2_text": "",
            "concept_2_color": "#2d6a5e",
            "note": ""
          }
        },
        "chapter_4": {
          "type": "chapter",
          "settings": {
            "number": "04",
            "title": "We believe the skull can be inflated like a ball",
            "toc_title": "The skull can be inflated",
            "divider": true,
            "text": "",
            "list_style": "grid",
            "items": "",
            "video_url": "",
            "media_position": "right",
            "media_frame": false,
            "caption": "",
            "concept_1_word": "収縮",
            "concept_1_label": "Deflating",
            "concept_1_text": "What we believe causes aging and asymmetry, and sits at the root of most disease",
            "concept_1_color": "#b5553a",
            "concept_2_word": "膨張",
            "concept_2_label": "Inflating",
            "concept_2_text": "Reverses those things — and a mouthguard can help do it",
            "concept_2_color": "#2d6a5e",
            "note": "As the skull inflates, the curve of Spee improves."
          }
        }
      },
      "block_order": [
        "chapter_1",
        "chapter_2",
        "chapter_3",
        "chapter_4"
      ],
      "settings": {
        "eyebrow": "The problem",
        "heading": "Why we think this keeps happening",
        "intro": "Reviv started from a hypothesis about structure rather than symptoms — set out here in the order we arrived at it.",
        "accent": "red",
        "show_toc": true,
